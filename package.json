{
  "name": "@iden3/js-jsonld-merklization",
  "version": "1.7.3",
  "description": "json ld merklization library",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "node": {
        "import": "./dist/node/esm/index.js",
        "require": "./dist/node/cjs/index.cjs"
      },
      "browser": "./dist/browser/esm/index.js",
      "umd": "./dist/browser/umd/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "type": "module",
  "sideEffects": false,
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:types": "tsc --declaration --emitDeclarationOnly",
    "build:node": "node ./scripts/node.js",
    "build:browser": "rollup -c scripts/browser.mjs",
    "build": "npm run clean && npm run build:node && npm run build:browser && npm run build:types",
    "clean": "rimraf ./dist",
    "test": "vitest run",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "lint": "biome ci . && cspell \"**/*.{ts,js,mjs}\" --no-progress"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iden3/js-jsonld-merklization.git"
  },
  "author": "",
  "license": "MIT or Apache-2.0",
  "bugs": {
    "url": "https://github.com/iden3/js-jsonld-merklization/issues"
  },
  "homepage": "https://github.com/iden3/js-jsonld-merklization#readme",
  "devDependencies": {
    "@iden3/biome-config": "https://github.com/iden3/eslint-config#biome-config",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/jsonld": "1.5.15",
    "@types/n3": "1.26.1",
    "@types/node": "25.9.3",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "4.1.9",
    "esbuild": "0.28.1",
    "playwright": "1.61.0",
    "rimraf": "6.1.3",
    "rollup": "4.62.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "@iden3/js-crypto": "1.3.3",
    "@iden3/js-merkletree": "1.5.2"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "jsonld": "9.0.0",
    "n3": "2.0.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
